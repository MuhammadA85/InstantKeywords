# Copy to .env and set on your host (this app reads real environment variables).
SITE_URL=https://yourdomain.com
SITE_NAME=SuggestScout
CONTACT_EMAIL=you@yourdomain.com

# Behind Render/Railway/Fly/Nginx/Cloudflare:
TRUST_PROXY=1
FORCE_HTTPS=1

# After AdSense approval:
ADSENSE_CLIENT=
AD_SLOT_TOP=
AD_SLOT_MID=

# Optional Google Analytics 4:
GA_MEASUREMENT_ID=

# Tuning (defaults shown):
# RATE_LIMIT_MAX=20
# RATE_LIMIT_WINDOW_MS=600000
# MAX_PER_IP=2
# MAX_GLOBAL=25
# UPSTREAM_DELAY_MS=150
