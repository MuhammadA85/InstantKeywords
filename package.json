{
  "name": "suggestscout",
  "version": "2.0.0",
  "private": true,
  "description": "Free Google Autocomplete keyword extractor (A-Z, prefix, questions, prepositions, numbers)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "npm run build:css",
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o public/styles.css --minify",
    "watch:css": "tailwindcss -c tailwind.config.js -i src/input.css -o public/styles.css --watch",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "tailwindcss": "^3.4.14"
  }
}
